# =============================================================================
# Секреты команды (НЕ коммитить .env)
# -----------------------------------------------------------------------------
# У каждого своя локальная копия:
#   1) cp .env.example .env   (Windows: copy .env.example .env)
#   2) вписать свои/общие ключи
#   3) перезапустить uvicorn и бота
#
# Общий ключ хакатона — в чате команды / менеджере паролей, не в git.
# CI/прод: переменные окружения хоста или secret store, не файл в репо.
# =============================================================================

# Yandex Cloud / AI Studio (обязательно для SpeechKit + YandexGPT на демо жюри)
YC_FOLDER_ID=b1gxxxxxxxxxxxxxxxx
YC_API_KEY=AQVNxxxxxxxxxxxxxxxxxxxxxxxx

# Full Yandex stack for jury demo
LLM_PROVIDER=yandex
STT_PROVIDER=yandex
TTS_PROVIDER=yandex

YANDEX_MODEL=yandexgpt
YANDEX_MODEL_VERSION=rc
# YANDEX_TEMPERATURE=0.3

# Без ключей: STT/TTS сами откатятся на Whisper / pyttsx3.
# LLM без ключей отдаёт rule/fallback-ответ (не полный YandexGPT).

# Telegram bot (optional)
# TG_BOT_TOKEN=
# TG_CHAT_ID=
# TG_BOT_URL=https://t.me/MtsSmartCallBot

# DATABASE_URL=sqlite:///D:/path/to/data/calls.db
